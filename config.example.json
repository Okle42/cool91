{
  "mode": "curve",
  "curve": [
    { "temp": 60, "rpm": 1000 },
    { "temp": 75, "rpm": 1800 },
    { "temp": 85, "rpm": 2600 },
    { "temp": 92, "rpm": 3600 },
    { "temp": 97, "rpm": 4900 }
