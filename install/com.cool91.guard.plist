<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.cool91.guard</string>
  <key>ProgramArguments</key>
  <array>
    <!-- 走 symlink 啟動：「登入項目與延伸功能」顯示的是執行檔名，這樣會列成「cool91-guard」而不是和面板混淆的「cool91」
         （AssociatedBundleIdentifiers 併到 app 底下需要同一個 Team ID，ad-hoc 簽章做不到） -->
    <string>/usr/local/bin/cool91-guard</string>
    <string>guard</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <!-- 不能用 Background：高負載時會被降到最低 QoS 餓死，1375 次 SMC 呼叫要跑好幾分鐘 —— 而那正是最需要控風扇的時候。
       Standard + nice -5 讓 guard 每 5 秒都排得到 CPU（實際用量 0.1%，不會搶到別人） -->
  <key>ProcessType</key><string>Standard</string>
  <key>Nice</key><integer>-5</integer>
  <!-- 主 log 由 guard 自己 append 到 /var/log/cool91.log（帶時間戳、可被 newsyslog 輪替）；這裡只接崩潰訊息 -->
  <key>StandardErrorPath</key><string>/var/log/cool91.err.log</string>
</dict>
</plist>
